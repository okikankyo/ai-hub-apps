# OpenAI API キー(未設定の場合はモックモードで起動)
OPENAI_API_KEY=

# 使用モデル
CHAT_MODEL=gpt-4o-mini
CLASSIFIER_MODEL=gpt-4o-mini

# コスト換算レート(円/ドル)
USD_JPY=150

# 私的利用の自動警告: 閾値(割合)と最低判定件数
PRIVATE_RATIO_WARN=0.3
PRIVATE_MIN_COUNT=5

# Google ログイン(両方設定すると有効になる)
# Google Cloud Console で OAuth クライアント(Webアプリ)を作成し、
# 承認済みリダイレクト URI に {BASE_URL}/auth/google/callback を登録すること
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 外部からアクセスする際の公開URL(リダイレクトURIの生成に使用)
BASE_URL=http://localhost:8787

# サーバー設定
PORT=8787
# DATA_DIR=./data
# SYSTEM_PROMPT=あなたは社内向けAIアシスタントです。
